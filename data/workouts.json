{
  "monday": {
    "name": "Push",
    "focus": "Chest, shoulders, triceps",
    "minutes": 45,
    "exercises": [
      {
        "id": "chest-press",
        "name": "Machine Chest Press",
        "sets": 3,
        "reps": "8\u201312",
        "muscles": "Chest, triceps, front shoulders",
        "setup": "Adjust the seat so the handles line up with mid-chest. Keep feet flat and shoulder blades supported.",
        "steps": [
          "Grip the handles with wrists straight.",
          "Press forward without locking the elbows.",
          "Pause briefly, then return under control."
        ],
        "mistakes": "Shrugging, bouncing the weight, or letting elbows travel too far behind the body.",
        "alternative": "Incline push-up or dumbbell press."
      },
      {
        "id": "shoulder-press",
        "name": "Machine Shoulder Press",
        "sets": 3,
        "reps": "8\u201312",
        "muscles": "Shoulders and triceps",
        "setup": "Adjust the seat so the handles begin near ear level. Keep ribs down.",
        "steps": [
          "Brace your midsection.",
          "Press upward smoothly.",
          "Lower until the elbows are comfortably below shoulder height."
        ],
        "mistakes": "Arching the lower back or forcing a painful range.",
        "alternative": "Neutral-grip dumbbell press."
      },
      {
        "id": "pec-deck",
        "name": "Pec Deck",
        "sets": 3,
        "reps": "10\u201315",
        "muscles": "Chest",
        "setup": "Set the seat so elbows are just below shoulder height.",
        "steps": [
          "Keep the chest tall.",
          "Bring the pads together without slamming them.",
          "Return slowly until you feel a comfortable stretch."
        ],
        "mistakes": "Shrugging or using momentum.",
        "alternative": "Cable fly."
      },
      {
        "id": "triceps-pressdown",
        "name": "Cable Triceps Pressdown",
        "sets": 3,
        "reps": "10\u201315",
        "muscles": "Triceps",
        "setup": "Set the cable high and stand close to the stack.",
        "steps": [
          "Pin elbows near your sides.",
          "Press the handle down.",
          "Return without letting elbows drift forward."
        ],
        "mistakes": "Leaning heavily or swinging.",
        "alternative": "Machine triceps extension."
      }
    ]
  },
